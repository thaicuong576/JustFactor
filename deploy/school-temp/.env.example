# Application
APP_ENV=development
PORT=8000

# Backend
API_V1_STR=/api/v1
SECRET_KEY=change-me-before-public-demo
ACCESS_TOKEN_EXPIRE_MINUTES=120
UPLOAD_DIR=storage/uploads

# Database
POSTGRES_USER=dev
POSTGRES_PASSWORD=devpass
POSTGRES_DB=school_temp
DATABASE_URL=postgresql://dev:devpass@db:5432/school_temp

# Frontend
# Set this to the VPS public URL/IP before exposing the UI to browsers.
# Example: VITE_API_URL=http://203.0.113.10:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Redis
REDIS_URL=redis://redis:6379/0

# Optional integrations. Fill on the VPS only; do not commit real secrets.
SUPABASE_URL=
SUPABASE_KEY=
SEPAY_API_URL=
SEPAY_ACCESS_TOKEN=
SEPAY_WEBHOOK_KEY=
VIETQR_API_URL=
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
GEMINI_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=dev@example.com
MAIL_PORT=587
MAIL_SERVER=localhost
